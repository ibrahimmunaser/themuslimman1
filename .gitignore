# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets (API keys, private keys — never commit)
/secrets

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
**/.next/

# scratch / build / working files (not meant for version control)
/scripts/fr-source/
/scripts/ar-source/
/scripts/i18n-work/
/tmp/
/stress/
tmp_check.txt
tmp-ar-sample.wav
emulator_screenshot_small.jpg

# production
/build

# media
/public/seerah-media
/Seerah-data

# misc
.DS_Store
*.pem
.git-backup-old

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore ALL env files (including ad-hoc ones like .env.vercel.prod
# pulled via `vercel env pull`) except the checked-in example template.
.env
.env.local
.env.*.local
.env.production
.env.development
.env.vercel*
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
