<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
			<string>fr</string>
			<string>id</string>
			<string>ms</string>
			<string>zh-Hans</string>
			<string>ru</string>
			<string>sw</string>
			<string>es</string>
			<string>de</string>
			<string>tr</string>
			<string>hi</string>
			<string>ur</string>
			<string>bn</string>
			<string>fa</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>The Muslim Man</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>The Muslim Man</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<!-- The app is portrait-only everywhere except full-screen video
			     playback: main.dart pins the app to portrait at startup, and
			     Chewie's full-screen mode explicitly requests landscape and
			     restores portrait on exit. Without landscape declared here,
			     iOS silently refuses that rotation and "full screen" video
			     stays portrait-boxed instead of actually going landscape. -->
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<!-- No NSAppTransportSecurity exceptions: all media is served over
		     HTTPS from R2 in production (the local dev proxy 410s in prod),
		     so a blanket NSAllowsArbitraryLoadsForMedia exception isn't
		     needed and only weakens transport security / invites extra App
		     Review scrutiny. -->
		<!-- Declares standard HTTPS-only crypto (no custom/proprietary
		     encryption). Required so TestFlight beta review submission
		     doesn't fail with "Build is missing export compliance". -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<true/>

		<!-- ── Salah features (merged from "Allah Is Calling") ──────────── -->
		<!-- Only when-in-use location is requested; the app never asks for
		     Always/background location. The Always key below is required by
		     Apple's static analysis because the geolocator plugin
		     references the always-authorization API, even though this app
		     never calls it. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Your location is used to calculate accurate prayer times for where you are. It never leaves your device.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Your location is used to calculate accurate prayer times for where you are. It never leaves your device.</string>
		<!-- AlarmKit (iOS 26+): required to schedule prominent prayer alarms. -->
		<key>NSAlarmKitUsageDescription</key>
		<string>The Muslim Man uses alarms to notify you when it is time for prayer.</string>
		<!-- App Guard stays hidden until Family Controls is actually signed
		     into this build. Flip to true only once
		     ENABLE_SCREEN_TIME_EXTENSIONS=1 and the Screen Time entitlement
		     is granted for this bundle ID — see IOS_PROPOSED_FIXES_FOR_APPROVAL.md
		     ported from the standalone app. -->
		<key>ScreenTimeGuardEnabled</key>
		<false/>
	</dict>
</plist>
