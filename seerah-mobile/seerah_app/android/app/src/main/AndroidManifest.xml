<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="com.android.vending.BILLING"/>

    <!-- ── Salah features (merged from "Allah Is Calling") ───────────────── -->
    <!-- Location: used to calculate accurate prayer times for the user. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- Notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Exact alarms so reminders fire on the minute the prayer enters.
         USE_EXACT_ALARM is granted automatically (no user dialog) for apps
         that are clock/alarm/prayer-time apps (API 33+). SCHEDULE_EXACT_ALARM
         is kept as a fallback for API 31–32 where USE_EXACT_ALARM did not yet
         exist; on those versions the user may be prompted in Settings. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Call-style presentation over the lock screen (Android 14+ requires
         user consent, requested at runtime). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- Restore scheduled reminders after device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- App Guard: covers a chosen "distracting" app with the "Allah is
         calling" screen for the 15 minutes after a prayer enters.
         PACKAGE_USAGE_STATS is a special AppOps permission — declaring it
         here does not grant it; the user must grant it from
         Settings.ACTION_USAGE_ACCESS_SETTINGS (see AppGuardPlugin). -->
    <!-- TEMPORARILY DISABLED together with the guard (GuardFeature.ENABLED =
    false): declaring a sensitive permission for a feature that is not
    shipping is a Play policy risk. Restore with the foreground-service
    block below when App Guard is re-enabled.
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    -->
    <!-- SYSTEM_ALERT_WINDOW ("Display over other apps") is also a special
         AppOps permission the user must grant separately; it exempts this
         app from Android 10+'s background-activity-start restriction so the
         guard screen can cover an app it did not launch. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- TEMPORARILY DISABLED (2026-11-15): Google Play's "Policy and
         programs → Foreground services" declaration for this specialUse
         subtype is pending review. Shipping a release that still declares
         this permission + the service below (uncommented) is undeclared
         and can get the listing's foreground-service type flagged / block
         production rollout. Restore both this permission and the <service>
         block below together once Google approves the declaration — see
         git history on this commit, and GuardFeature.kt which is the
         matching runtime kill switch.
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    -->

    <application
        android:label="The Muslim Man"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ── Salah features (merged from "Allah Is Calling") ───────────── -->
        <!-- flutter_local_notifications: deliver scheduled notifications and
             restore them after reboot. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <!-- Handles notification action button taps (Pray Now / Decline),
             including background handling of Decline. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Fires at the exact moment a prayer enters and force-launches
             the app when "Display over other apps" is granted, so the call
             screen takes over even while the phone is unlocked and in
             another app (the ordinary notification's fullScreenIntent only
             auto-presents while the device is locked). -->
        <receiver
            android:name=".IncomingCallAlarmReceiver"
            android:exported="false" />
        <!-- Re-arms IncomingCallScheduling's alarms after a reboot — raw
             AlarmManager alarms do not survive one on their own (mirrors
             ScheduledNotificationBootReceiver/GuardBootReceiver below). -->
        <receiver
            android:name=".IncomingCallBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- App Guard: covers a chosen app with the "Allah is calling"
             screen when it is opened during the 15 minutes after a prayer
             enters. Own task, excluded from recents, no OS animation delay
             expected from the user since it is launched the instant the
             guarded app is detected in the foreground. -->
        <!-- Native (non-Flutter) block screen — a second Flutter engine
             started from the guard foreground service was painting only the
             green window background and never the Dart UI on device. -->
        <activity
            android:name=".guard.GuardBlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.themuslimman.seerah.guard"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/GuardLaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"/>

        <!-- Foreground service that watches for guarded apps coming to the
             foreground during a prayer's 15-minute guard window.
             TEMPORARILY DISABLED (2026-11-15): see the matching comment
             above FOREGROUND_SERVICE_SPECIAL_USE. Restore together.
        <service
            android:name=".guard.AppGuardForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the foreground app so a chosen app can be covered with a prayer-time reminder screen"/>
        </service>
        -->

        <!-- Fires at prayer time (scheduled alongside the prayer
             notification) and starts the 15-minute guard window. A plain
             exact alarm, independent of flutter_local_notifications, so the
             guard runs even if the Flutter engine/isolate is not alive. -->
        <receiver
            android:name=".guard.GuardWindowAlarmReceiver"
            android:exported="false"/>

        <!-- Restarts any guard window that should still be active after a
             reboot (mirrors ScheduledNotificationBootReceiver). -->
        <receiver
            android:name=".guard.GuardBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Force the Skia renderer instead of Impeller. Impeller has known
             visual-corruption bugs on some Android GPU/driver combos
             (notably several Samsung devices) — borders and icons draw
             correctly but certain text/alpha-blended layers render as
             near-invisible. This was reported only on a real Samsung
             device and could not be reproduced on a Pixel emulator with
             the same build, which points squarely at this class of bug. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so url_launcher (used to open the Play Store
             subscription-management page from the Profile screen's
             "Billing & Subscription" action) can resolve a browsable https
             handler on Android 11+ package-visibility rules — without this,
             launchUrl()/canLaunchUrl() can silently fail to find the Play
             Store app or the system browser to hand the URL to. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- App Guard: list launchable apps for the "choose apps to guard"
             picker. This exact filter signature is exempted from Android
             11+ package-visibility filtering. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
